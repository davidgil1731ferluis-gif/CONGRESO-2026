rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function verified() { return signed() && request.auth.token.email_verified == true; }
  function email() { return request.auth.token.email.lower(); }
  function admin() { return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
  function owns(r) { return signed() && (r.uid == request.auth.uid && r.submissionState == 'draft' || verified() && r.email == email()); }
  function address(e) { return e is string && e.size() <= 254 && e.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+[.][a-z]{2,}$'); }
  function approved(r) { return r.status == 'approved' && r.payment == 'approved'; }
  function attendee(rid,cid) { let r = get(/databases/$(database)/documents/registrations/$(rid)).data; let c = get(/databases/$(database)/documents/conferences/$(cid)).data; return verified() && r.email == email() && approved(r) && r.eventId == c.eventId && c.active && request.time >= c.opensAt && request.time <= c.closesAt; }
  function guardAt(q,a,i) { return i >= q.guards.size() || guard(q.guards[i],a); }
  function guard(g,a) { let v = a.get(g.field,g.multiple ? [] : ''); let same = g.multiple ? v is list && g.value in v : v == g.value; return g.operator == 'neq' ? !same : same; }
  function answerAt(e,a,i) { return i >= e.questionRules.size() || answer(e.questionRules[i],a); }
  function answer(q,a) { let present = q.id in a; let v = a.get(q.id,''); let visible = q.guards.size() == 0 || (guardAt(q,a,0) && guardAt(q,a,1) && guardAt(q,a,2) && guardAt(q,a,3) && guardAt(q,a,4)); return !visible ? !present : (!present || v == '' || v == []) ? !q.required : value(q,v); }
  function value(q,v) { return q.type == 'checkbox' ? v is list && v.size() <= 50 && v.hasOnly(q.options) && v.toSet().size() == v.size() : v is string && v.size() <= 4000 && (q.type in ['select','radio'] ? v in q.options : q.type == 'email' ? v.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') : q.type == 'number' ? v.matches('^-?[0-9]+([.][0-9]+)?$') : q.type == 'date' ? v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') : true); }
  function answersPart(e,a,n) { return answerAt(e,a,n*2) && answerAt(e,a,n*2+1); }
  function checkPart(rid,r,i) { return i*2 >= r.questionCount || get(/databases/$(database)/documents/registrations/$(rid)/answerChecks/$('part'+string(i))).data.draftCreatedAt == r.createdAt; }
  function summary(rid,r,g) { return checkPart(rid,r,g*5) && checkPart(rid,r,g*5+1) && checkPart(rid,r,g*5+2) && checkPart(rid,r,g*5+3) && checkPart(rid,r,g*5+4); }
  function submitted(rid,r) { return (r.questionCount <= 0 || get(/databases/$(database)/documents/registrations/$(rid)/answerSummaries/group0).data.draftCreatedAt == r.createdAt) && (r.questionCount <= 10 || get(/databases/$(database)/documents/registrations/$(rid)/answerSummaries/group1).data.draftCreatedAt == r.createdAt) && (r.questionCount <= 20 || get(/databases/$(database)/documents/registrations/$(rid)/answerSummaries/group2).data.draftCreatedAt == r.createdAt) && (r.questionCount <= 30 || get(/databases/$(database)/documents/registrations/$(rid)/answerSummaries/group3).data.draftCreatedAt == r.createdAt) && (r.questionCount <= 40 || get(/databases/$(database)/documents/registrations/$(rid)/answerSummaries/group4).data.draftCreatedAt == r.createdAt) && (r.questionCount <= 50 || get(/databases/$(database)/documents/registrations/$(rid)/answerSummaries/group5).data.draftCreatedAt == r.createdAt) && (r.questionCount <= 60 || get(/databases/$(database)/documents/registrations/$(rid)/answerSummaries/group6).data.draftCreatedAt == r.createdAt) && (r.questionCount <= 70 || get(/databases/$(database)/documents/registrations/$(rid)/answerSummaries/group7).data.draftCreatedAt == r.createdAt) && getAfter(/databases/$(database)/documents/jobs/$('registration_'+rid)).data.registrationId == rid; }
  function judge(p) { return verified() && email() in p.judgeIds && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role == 'judge' && exists(/databases/$(database)/documents/judgeInvitations/$(email())); }
  function total(p,m) { return ((0 >= p.scoreKeys.size() ? 0 : m[0]*p.rubric.criteria[0].weight) + (1 >= p.scoreKeys.size() ? 0 : m[1]*p.rubric.criteria[1].weight) + (2 >= p.scoreKeys.size() ? 0 : m[2]*p.rubric.criteria[2].weight) + (3 >= p.scoreKeys.size() ? 0 : m[3]*p.rubric.criteria[3].weight) + (4 >= p.scoreKeys.size() ? 0 : m[4]*p.rubric.criteria[4].weight) + (5 >= p.scoreKeys.size() ? 0 : m[5]*p.rubric.criteria[5].weight) + (6 >= p.scoreKeys.size() ? 0 : m[6]*p.rubric.criteria[6].weight) + (7 >= p.scoreKeys.size() ? 0 : m[7]*p.rubric.criteria[7].weight) + (8 >= p.scoreKeys.size() ? 0 : m[8]*p.rubric.criteria[8].weight) + (9 >= p.scoreKeys.size() ? 0 : m[9]*p.rubric.criteria[9].weight) + (10 >= p.scoreKeys.size() ? 0 : m[10]*p.rubric.criteria[10].weight) + (11 >= p.scoreKeys.size() ? 0 : m[11]*p.rubric.criteria[11].weight) + (12 >= p.scoreKeys.size() ? 0 : m[12]*p.rubric.criteria[12].weight) + (13 >= p.scoreKeys.size() ? 0 : m[13]*p.rubric.criteria[13].weight) + (14 >= p.scoreKeys.size() ? 0 : m[14]*p.rubric.criteria[14].weight) + (15 >= p.scoreKeys.size() ? 0 : m[15]*p.rubric.criteria[15].weight) + (16 >= p.scoreKeys.size() ? 0 : m[16]*p.rubric.criteria[16].weight) + (17 >= p.scoreKeys.size() ? 0 : m[17]*p.rubric.criteria[17].weight) + (18 >= p.scoreKeys.size() ? 0 : m[18]*p.rubric.criteria[18].weight) + (19 >= p.scoreKeys.size() ? 0 : m[19]*p.rubric.criteria[19].weight)) / 5; }
  function evaluation(p,v) { let sum = total(p,v.marks); return v.marks is list && v.marks.size() == p.scoreKeys.size() && v.marks.toSet().hasOnly([1,2,3,4,5]) && v.total >= sum-0.011 && v.total <= sum+0.011 && v.comments is string && v.comments.size() <= 4000; }
  function entitlement() { return exists(/databases/$(database)/documents/judgeInvitations/$(email())) || exists(/databases/$(database)/documents/activationEntitlements/$(email())) && approved(get(/databases/$(database)/documents/registrations/$(get(/databases/$(database)/documents/activationEntitlements/$(email())).data.registrationId)).data); }
  function participantRole(p) { return p.role in ['speaker','poster'] && get(/databases/$(database)/documents/registrations/$(p.registrationId)).data.email == email() && get(/databases/$(database)/documents/registrations/$(p.registrationId)).data.role == p.role && approved(get(/databases/$(database)/documents/registrations/$(p.registrationId)).data); }
  match /admins/{uid} { allow get: if verified() && uid == request.auth.uid; allow list,write: if false; }
  match /accounts/{uid} {
   allow get: if verified() && (uid == request.auth.uid || admin()); allow list: if admin();
   allow create: if verified() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','email','name','role','activated','registrationId']) && request.resource.data.uid == uid && request.resource.data.email == email() && request.resource.data.name is string && request.resource.data.name.size() <= 160 && request.resource.data.activated == false && (request.resource.data.role == 'attendee' || request.resource.data.role == 'admin' && admin() || request.resource.data.role == 'judge' && exists(/databases/$(database)/documents/judgeInvitations/$(email())) || participantRole(request.resource.data));
   allow update: if verified() && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activated','updatedAt']) && request.resource.data.activated == true && request.resource.data.updatedAt == request.time && entitlement() || verified() && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','registrationId']) && (request.resource.data.role == 'attendee' || request.resource.data.role == 'admin' && admin() || request.resource.data.role == 'judge' && exists(/databases/$(database)/documents/judgeInvitations/$(email())) || participantRole(request.resource.data));
  }
  match /events/{eid} { allow read,write: if admin(); }
  match /eventVersions/{eid}/versions/{version} { allow read: if resource.data.published; allow write: if admin(); }
  match /publicEvents/{eid} { allow read: if resource.data.published == true; allow write: if admin(); }
  match /registrations/{rid} {
   allow get: if signed() && (!exists(/databases/$(database)/documents/registrations/$(rid)) || owns(resource.data) || admin());
   allow list: if admin() || owns(resource.data);
   allow create: if signed() && request.resource.data.keys().hasOnly(['name','email','identification','role','uid','eventId','answers','status','payment','version','consentAt','createdAt','submissionState','questionCount']) && request.resource.data.uid == request.auth.uid && address(request.resource.data.email) && rid == request.resource.data.eventId+'_'+request.resource.data.email && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160 && request.resource.data.identification is string && request.resource.data.identification.size() > 0 && request.resource.data.identification.size() <= 80 && request.resource.data.role in ['speaker','poster','attendee'] && request.resource.data.status == 'pending' && request.resource.data.payment == 'pending' && request.resource.data.createdAt == request.time && request.resource.data.consentAt == request.time && request.resource.data.version == get(/databases/$(database)/documents/publicEvents/$(request.resource.data.eventId)).data.version && request.resource.data.submissionState == 'draft' && request.resource.data.questionCount == get(/databases/$(database)/documents/publicEvents/$(request.resource.data.eventId)).data.questionRules.size() && request.resource.data.questionCount > 0 && request.resource.data.questionCount <= 80 && request.resource.data.answers.keys().hasOnly(get(/databases/$(database)/documents/publicEvents/$(request.resource.data.eventId)).data.questionIds);
   allow update: if signed() && owns(resource.data) && resource.data.submissionState == 'draft' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissionState','submittedAt']) && request.resource.data.submissionState == 'submitted' && request.resource.data.submittedAt == request.time && submitted(rid,resource.data) || admin() && resource.data.submissionState == 'submitted' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','payment','paymentReference','role','updatedAt']) && request.resource.data.status in ['pending','approved','rejected'] && request.resource.data.payment in ['pending','approved','rejected'] && request.resource.data.role in ['speaker','poster','attendee'] && request.resource.data.updatedAt == request.time && (request.resource.data.payment != 'approved' || request.resource.data.status == 'approved' && request.resource.data.paymentReference is string && request.resource.data.paymentReference.size() > 0);
   match /answerChecks/{part} { allow get: if owns(get(/databases/$(database)/documents/registrations/$(rid)).data); allow create: if signed() && owns(get(/databases/$(database)/documents/registrations/$(rid)).data) && get(/databases/$(database)/documents/registrations/$(rid)).data.submissionState == 'draft' && request.resource.data.keys().hasOnly(['part','draftCreatedAt']) && request.resource.data.part is int && request.resource.data.part >= 0 && request.resource.data.part < 40 && part == 'part'+string(request.resource.data.part) && request.resource.data.draftCreatedAt == get(/databases/$(database)/documents/registrations/$(rid)).data.createdAt && answersPart(get(/databases/$(database)/documents/eventVersions/$(get(/databases/$(database)/documents/registrations/$(rid)).data.eventId)/versions/$(string(get(/databases/$(database)/documents/registrations/$(rid)).data.version))).data,get(/databases/$(database)/documents/registrations/$(rid)).data.answers,request.resource.data.part); }
   match /answerSummaries/{group} { allow get: if owns(get(/databases/$(database)/documents/registrations/$(rid)).data); allow create: if signed() && owns(getAfter(/databases/$(database)/documents/registrations/$(rid)).data) && request.resource.data.keys().hasOnly(['group','draftCreatedAt']) && request.resource.data.group in [0,1,2,3,4,5,6,7] && group == 'group'+string(request.resource.data.group) && request.resource.data.draftCreatedAt == getAfter(/databases/$(database)/documents/registrations/$(rid)).data.createdAt && summary(rid,getAfter(/databases/$(database)/documents/registrations/$(rid)).data,request.resource.data.group); }
  }
  match /registeredEmails/{e} { allow get: if verified() && e == email() || admin(); allow create,update: if signed() && address(e) && request.resource.data.keys().hasOnly(['email']) && request.resource.data.email == e; }
  match /accessRequests/{e} { allow read: if admin(); allow create,update: if signed() && address(e) && request.resource.data.keys().hasOnly(['email','requestedBy','createdAt','status']) && request.resource.data.email == e && request.resource.data.requestedBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.status == 'queued' && (!exists(/databases/$(database)/documents/accessRequests/$(e)) || request.time > resource.data.createdAt + duration.value(5,'m')); }
  match /judgeInvitations/{e} { allow get: if admin() || verified() && e == email(); allow list,write: if admin(); }
  match /activationEntitlements/{e} { allow get: if admin() || verified() && e == email(); allow write: if admin(); }
  match /conferences/{cid} { allow read: if verified(); allow write: if admin() && request.resource.data.opensAt is timestamp && request.resource.data.closesAt is timestamp && request.resource.data.closesAt > request.resource.data.opensAt && (request.resource.data.speakerRegistrationId == '' || approved(get(/databases/$(database)/documents/registrations/$(request.resource.data.speakerRegistrationId)).data) && get(/databases/$(database)/documents/registrations/$(request.resource.data.speakerRegistrationId)).data.role == 'speaker'); }
  match /conferenceSecrets/{cid} { allow get: if admin() || verified() && get(/databases/$(database)/documents/registrations/$(get(/databases/$(database)/documents/conferences/$(cid)).data.speakerRegistrationId)).data.email == email() && approved(get(/databases/$(database)/documents/registrations/$(get(/databases/$(database)/documents/conferences/$(cid)).data.speakerRegistrationId)).data) && get(/databases/$(database)/documents/registrations/$(get(/databases/$(database)/documents/conferences/$(cid)).data.speakerRegistrationId)).data.role == 'speaker'; allow write: if admin(); }
  match /uploadRequests/{id} { allow create: if verified() && request.resource.data.keys().hasOnly(['uid','eventId','registrationId','conferenceId','code','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time && attendee(request.resource.data.registrationId,request.resource.data.conferenceId) && request.resource.data.eventId == get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.eventId && request.resource.data.code == get(/databases/$(database)/documents/conferenceSecrets/$(request.resource.data.conferenceId)).data.code; allow get: if resource.data.uid == request.auth.uid && attendee(resource.data.registrationId,resource.data.conferenceId); }
  match /evidenceReceipts/{id} { allow get: if verified() && resource.data.uid == request.auth.uid; allow write: if false; }
  match /attendance/{id} { allow get: if verified() && (!exists(/databases/$(database)/documents/attendance/$(id)) || resource.data.uid == request.auth.uid || admin()); allow list: if verified() && (resource.data.uid == request.auth.uid || admin());
   allow create: if verified() && request.resource.data.keys().hasOnly(['uid','email','eventId','registrationId','conferenceId','receiptId','code','stampedAt','certificateStatus','evidenceStatus']) && request.resource.data.uid == request.auth.uid && request.resource.data.email == email() && id == request.resource.data.registrationId+'_'+request.resource.data.conferenceId && attendee(request.resource.data.registrationId,request.resource.data.conferenceId) && request.resource.data.eventId == get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.eventId && request.resource.data.stampedAt == request.time && request.resource.data.certificateStatus == 'queued' && request.resource.data.evidenceStatus == 'ready' && request.resource.data.code == get(/databases/$(database)/documents/conferenceSecrets/$(request.resource.data.conferenceId)).data.code && get(/databases/$(database)/documents/evidenceReceipts/$(request.resource.data.receiptId)).data.uid == request.auth.uid && get(/databases/$(database)/documents/evidenceReceipts/$(request.resource.data.receiptId)).data.registrationId == request.resource.data.registrationId && get(/databases/$(database)/documents/evidenceReceipts/$(request.resource.data.receiptId)).data.conferenceId == request.resource.data.conferenceId && getAfter(/databases/$(database)/documents/jobs/$('certificate_'+id)).data.attendanceId == id;
  }
  match /categories/{id} { allow read,write: if admin(); }
  match /posters/{pid} { allow get,list: if admin() || verified() && (resource.data.authorEmail == email() || judge(resource.data)); allow create: if admin() && request.resource.data.evaluationCount == 0; allow update: if admin() && resource.data.evaluationCount == 0 || judge(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evaluationCount','reportStatus']) && request.resource.data.evaluationCount == resource.data.evaluationCount + 1 && request.resource.data.reportStatus == (request.resource.data.evaluationCount == resource.data.judgeIds.size() ? 'queued' : 'pending') && !exists(/databases/$(database)/documents/posters/$(pid)/evaluations/$(email())) && getAfter(/databases/$(database)/documents/posters/$(pid)/evaluations/$(email())).data.createdAt == request.time && (request.resource.data.reportStatus != 'queued' || getAfter(/databases/$(database)/documents/jobs/$('evaluation_'+pid)).data.posterId == pid);
   match /evaluations/{e} { allow get: if admin() || verified() && e == email() && judge(get(/databases/$(database)/documents/posters/$(pid)).data); allow list: if admin() || verified() && resource.data.judgeUid == email(); allow create: if judge(get(/databases/$(database)/documents/posters/$(pid)).data) && e == email() && request.resource.data.keys().hasOnly(['marks','comments','total','posterId','judgeUid','judgeName','createdAt']) && request.resource.data.judgeUid == email() && request.resource.data.posterId == pid && request.resource.data.createdAt == request.time && request.resource.data.judgeName == get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.name && evaluation(get(/databases/$(database)/documents/posters/$(pid)).data,request.resource.data) && getAfter(/databases/$(database)/documents/posters/$(pid)).data.evaluationCount == get(/databases/$(database)/documents/posters/$(pid)).data.evaluationCount + 1; }
  }
  match /settings/{id} { allow read,write: if admin(); }
  match /publicSettings/{id} { allow read: if verified(); allow write: if admin(); }
  match /audit/{id} { allow read,create: if admin(); }
  match /jobs/{id} { allow read: if admin(); allow create: if request.resource.data.keys().hasOnly(['kind','registrationId','attendanceId','posterId','judgeEmail','eventId','status','attempts','nextAttempt','createdAt']) && request.resource.data.status == 'queued' && request.resource.data.attempts == 0 && request.resource.data.nextAttempt == 0 && request.resource.data.createdAt == request.time && (admin() || request.resource.data.kind == 'registration' && id == 'registration_'+request.resource.data.registrationId && getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.uid == request.auth.uid && getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.submittedAt == request.time || request.resource.data.kind == 'certificate' && id == 'certificate_'+request.resource.data.attendanceId && getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.attendanceId)).data.uid == request.auth.uid && getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.attendanceId)).data.stampedAt == request.time || request.resource.data.kind == 'evaluation' && id == 'evaluation_'+request.resource.data.posterId && judge(getAfter(/databases/$(database)/documents/posters/$(request.resource.data.posterId)).data) && getAfter(/databases/$(database)/documents/posters/$(request.resource.data.posterId)).data.evaluationCount == getAfter(/databases/$(database)/documents/posters/$(request.resource.data.posterId)).data.judgeIds.size()); allow update: if admin() && resource.data.status == 'error' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','attempts','nextAttempt','error']) && request.resource.data.status == 'queued' && request.resource.data.attempts == 0 && request.resource.data.nextAttempt == 0; }
 }
}

